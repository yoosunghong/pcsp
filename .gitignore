# Virtual environments / secrets
.env
.venv
# NOTE: this was previously the bare pattern `env/`, which gitignore matches at
# ANY depth — so it silently excluded `research/src/env/` (the Mini-Inzoi
# environment: v3_constants, mini_inzoi_v3, action_semantics). That module was
# therefore never committed. Anchored to the repo root so only a top-level
# virtualenv matches and the recovered research package remains trackable.
/env/
venv/

# Jupyter
.ipynb_checkpoints/

